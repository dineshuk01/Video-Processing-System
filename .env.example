# General App Settings
PORT=5000

# Which application(s) this server runs:
#   all   = user site at / and admin dashboard at /admin (development)
#   user  = only the public site and its read-only API
#   admin = only the admin dashboard and API
APP_MODE=all

# When the apps run as separate servers (npm run dev:split): one port each, and where the admin's
# "View public site" link should point.
# USER_PORT=5000
# ADMIN_PORT=5001
# USER_APP_URL=http://localhost:5000/

# Admin sign-in key for the dashboard and every /api/admin route. REQUIRED in production:
# without it, admin stays open in development and is switched off when NODE_ENV=production.
# Use a long random value, e.g. `openssl rand -hex 32`.
ADMIN_API_KEY=change-me
ADMIN_SESSION_HOURS=12

# Serve /metrics to Prometheus without the admin key (only on a private network)
# METRICS_PUBLIC=true

# Local mode media/upload URLs are relative (work from any host). Set this only if the apps are
# served from a different origin than the API.
# PUBLIC_BASE_URL=https://videos.example.com

# FFmpeg speed/size trade-off: ultrafast, superfast, veryfast (default), faster, fast, medium, slow.
# Faster presets finish sooner but make slightly larger files. Try ultrafast on a slow machine.
# FFMPEG_PRESET=veryfast

# Placeholder sample captions are OFF by default (they are not real captions)
# ENABLE_PLACEHOLDER_CAPTIONS=true
NODE_ENV=development
MAX_UPLOAD_SIZE_MB=1000
ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/x-matroska

# Service Provider selection: 'local' (Option A - mock) or 'aws' (real AWS)
PROVIDER=local

# Local Provider Settings (Used when PROVIDER=local)
LOCAL_DATA_DIR=./data
LOCAL_S3_TEMP_BUCKET=s3-temp
LOCAL_S3_PUBLIC_BUCKET=s3-public
LOCAL_SQS_QUEUE_NAME=video-processing-queue

# AWS Provider Settings (Used when PROVIDER=aws)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=mock-key-id-for-local
AWS_SECRET_ACCESS_KEY=mock-secret-key-for-local
AWS_S3_TEMP_BUCKET=my-raw-video-bucket
AWS_S3_PUBLIC_BUCKET=my-hls-streaming-bucket
AWS_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/video-processing-queue

# AWS ECS Fargate Settings (Used when PROVIDER=aws)
ECS_CLUSTER_NAME=video-processing-cluster
ECS_TASK_DEFINITION=video-transcoder-task
ECS_CONTAINER_NAME=video-transcoder
ECS_SUBNETS=subnet-xxxxxxxxxxxxxxxxx
ECS_SECURITY_GROUPS=sg-xxxxxxxxxxxxxxxxx

# CDN Settings (Optional — leave blank for direct S3/local URLs)
# CDN_BASE_URL=https://d1234abcde.cloudfront.net

# Video quality: x264 CRF, lower = better quality and bigger files (default 17, range 14-30).
# FFMPEG_CRF=17
